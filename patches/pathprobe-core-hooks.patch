+/*
+ * pathprobe hooks — add_path competition probe
+ *
+ * Both default to NULL (no-op). pathprobe.so sets them in _PG_init().
+ * pathprobe_path_rejected_hook: new_path dominated; dominated_by is the
+ *   old path that dominated it. new_path pfree'd after hook returns.
+ * pathprobe_path_accepted_hook: new_path survived; dominated_list may be NIL.
+ *   Paths in dominated_list are freed only after the hook returns.
+ * pathprobe_path_removed_hook: new_path was rejected after it had removed
+ *   removed_list from the pathlist; those are freed after the hook returns.
+ */
+typedef void (*pathprobe_path_rejected_hook_type)(RelOptInfo *rel,
+												  Path *new_path,
+												  Path *dominated_by);
+typedef void (*pathprobe_path_accepted_hook_type)(RelOptInfo *rel,
+												  Path *new_path,
+												  List *dominated_list);
+
+PGDLLIMPORT pathprobe_path_rejected_hook_type pathprobe_path_rejected_hook = NULL;
+PGDLLIMPORT pathprobe_path_accepted_hook_type pathprobe_path_accepted_hook = NULL;
+PGDLLIMPORT pathprobe_path_removed_hook_type pathprobe_path_removed_hook = NULL;
+
+/*
+ * pathprobe_path_skipped_hook — defined here (pathnode.c), called from joinpath.c.
+ * Fires when add_path_precheck() returns false: join path never constructed.
+ */
+PGDLLIMPORT pathprobe_path_skipped_hook_type pathprobe_path_skipped_hook = NULL;
+
+
