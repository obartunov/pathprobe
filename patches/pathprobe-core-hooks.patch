  *		MISC. PATH UTILITIES
  *****************************************************************************/
@@ -460,6 +489,8 @@ add_path(RelOptInfo *parent_rel, Path *new_path)
 {
 	bool		accept_new = true;	/* unless we find a superior old path */
 	int			insert_at = 0;	/* where to insert new item */
+	List	   *dominated_paths = NIL;	/* paths new_path displaces, for hook */
+	Path	   *dominated_by = NULL;	/* old path that rejects new_path */
 	List	   *new_path_pathkeys;
 	ListCell   *p1;
 
@@ -627,7 +658,9 @@ add_path(RelOptInfo *parent_rel, Path *new_path)
 			/*
 			 * Delete the data pointed-to by the deleted cell, if possible
 			 */
-			if (!IsA(old_path, IndexPath))
+			if (pathprobe_path_accepted_hook || pathprobe_path_removed_hook)
+				dominated_paths = lappend(dominated_paths, old_path);
+			else if (!IsA(old_path, IndexPath))
 				pfree(old_path);
 		}
 		else
@@ -648,21 +681,52 @@ add_path(RelOptInfo *parent_rel, Path *new_path)
 		 * new_path cannot dominate any other elements of the pathlist.
 		 */
 		if (!accept_new)
+		{
+			dominated_by = old_path;
 			break;
+		}
 	}
 
 	if (accept_new)
 	{
+		/* new_path survived — call accepted hook with displaced list */
+		if (pathprobe_path_accepted_hook)
+			pathprobe_path_accepted_hook(parent_rel, new_path, dominated_paths);
 		/* Accept the new path: insert it at proper place in pathlist */
 		parent_rel->pathlist =
 			list_insert_nth(parent_rel->pathlist, insert_at, new_path);
 	}
 	else
 	{
+		/*
+		 * new_path was rejected: dominated_by is the first old path, in
+		 * pathlist order, that dominates it.
+		 */
+		if (pathprobe_path_rejected_hook)
+			pathprobe_path_rejected_hook(parent_rel, new_path, dominated_by);
+
+		/*
+		 * The loop may have removed old paths before it found dominated_by.
+		 * They are gone from the pathlist and freed below.
+		 */
+		if (pathprobe_path_removed_hook && dominated_paths != NIL)
+			pathprobe_path_removed_hook(parent_rel, new_path, dominated_paths);
 		/* Reject and recycle the new path */
 		if (!IsA(new_path, IndexPath))
 			pfree(new_path);
 	}
+
+	/*
+	 * Free the old paths the loop removed but kept for the hooks.  This is
+	 * needed on the reject path too: the loop may remove old paths before it
+	 * finds one that dominates new_path.
+	 */
+	foreach_ptr(Path, dpath, dominated_paths)
+	{
+		if (!IsA(dpath, IndexPath))
+			pfree(dpath);
+	}
+	list_free(dominated_paths);
